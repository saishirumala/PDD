# Core Settings
PORT=8000
SECRET_KEY=change_this_secret_to_something_very_secure_and_long_1234567890
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings
# For Docker, use: postgresql://postgres:postgres@postgres:5432/nutriguide
# For local dev without Docker, use: postgresql://postgres:postgres@localhost:5432/nutriguide
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nutriguide

# AI Provider Settings
# If AI_API_KEY is empty or not provided, the app runs in Mock AI mode automatically
AI_API_KEY=
AI_PROVIDER=gemini

# CORS Settings
# Comma-separated list of origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# Upload settings
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5
